# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
venv/
.venv/
env/

# 模型权重与训练产物（体积大，按需单独管理）
models/
*.pth
*.pt
*.ckpt
*.onnx

# 数据集（原始 SGF / 生成的 npz 较大）
# ⚠ 必须是 `/data`：**裸 `data` 会匹配任意层级的 data 目录**，包括
# `src/data/` —— 那里面是要提交源码的（`katago_npz.py` / `pos_hash.py`）。
# 曾因此需要 `git add -f` 才能提交 `src/data/katago_npz.py`。
/data
/data/*.npz
/data/*.tgz
/data/*.tar.gz
/data/raw/
/data/games/
/data/*.sgf

# 日志与中间产物
runs/
logs/
*.log
wandb/

# IDE
.vscode/
.idea/
*.swp

# 工具缓存（CodeGraph 的 SQLite 索引，本机 19.6 MB，随代码自动重建）
# ⚠ 必须锚定：裸 `.codegraph` 会匹配任意层级
/.codegraph/

# 系统
.DS_Store
Thumbs.db
/tmp
*.zip
/docs
/katago
# Windows 保留设备名 'nul' 的残留产物（来源未查明，全量门禁后偶发）
nul.npz
tmp_smoke*.py
